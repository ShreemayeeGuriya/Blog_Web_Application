<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post — Blogger</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="write-page">

    <!-- Navbar -->
    <nav class="write-nav">
        <a class="nav-logo" href="/">Blogger</a>
        <a class="btn-create" href="/">← Back to Posts</a>
    </nav>

    <!-- Edit Form -->
    <div class="write-container">
        <h1 class="write-heading">Edit Post</h1>
        <form class="write-form" action="/edit/<%= post.id %>" method="POST">
            <input
                class="write-input"
                type="text"
                name="title"
                value="<%= post.title %>"
                placeholder="Post title..."
            >
            <textarea
                class="write-textarea"
                name="content"
                placeholder="Write your story..."
            ><%= post.content %></textarea>
            <div class="write-submit-row">
                <button class="btn-publish" type="submit">Save Changes</button>
            </div>
        </form>
    </div>

</body>
</html>